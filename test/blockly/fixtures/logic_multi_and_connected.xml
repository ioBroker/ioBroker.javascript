<!-- The multi-and block with three connected conditions.
     Its toolbox entry carries the mutation but leaves every input empty, so the generator falls
     through to the "false" fallback and the join over the conditions was never covered. -->
<xml xmlns="https://developers.google.com/blockly/xml">
  <block type="logic_multi_and">
    <mutation items="3"></mutation>
    <value name="AND0">
      <block type="logic_compare">
        <field name="OP">GT</field>
        <value name="A">
          <shadow type="math_number">
            <field name="NUM">10</field>
          </shadow>
        </value>
        <value name="B">
          <shadow type="math_number">
            <field name="NUM">5</field>
          </shadow>
        </value>
      </block>
    </value>
    <value name="AND1">
      <block type="logic_boolean">
        <field name="BOOL">TRUE</field>
      </block>
    </value>
    <value name="AND2">
      <block type="logic_between">
        <field name="MIN_OPERATOR">LE</field>
        <field name="MAX_OPERATOR">LT</field>
        <value name="MIN">
          <shadow type="math_number">
            <field name="NUM">0</field>
          </shadow>
        </value>
        <value name="VALUE">
          <shadow type="math_number">
            <field name="NUM">7</field>
          </shadow>
        </value>
        <value name="MAX">
          <shadow type="math_number">
            <field name="NUM">10</field>
          </shadow>
        </value>
      </block>
    </value>
  </block>
</xml>
