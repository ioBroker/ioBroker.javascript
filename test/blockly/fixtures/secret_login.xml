<!-- The credential block reading the "login" form. The toolbox entry only ever shows the default
     ("key" of a name that needs no quoting), so neither another attribute nor a credential name
     with a space was covered. -->
<xml xmlns="https://developers.google.com/blockly/xml">
  <block type="debug">
    <field name="Severity">info</field>
    <value name="TEXT">
      <block type="secret">
        <field name="NAME">My Mail Account</field>
        <field name="ATTR">login</field>
      </block>
    </value>
  </block>
</xml>
