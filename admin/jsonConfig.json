                    "text": "Strict options description",
                    "xs": 12,
                    "sm": 12,
                    "style": {
                        "marginBottom": 8
                    }
                },
                "tsNoImplicitAny": {
                    "newLine": true,
                    "type": "select",
                    "label": "noImplicitAny",
                    "options": [
                        { "label": "Follow strict", "value": "" },
                        { "label": "Enabled", "value": "true" },
                        { "label": "Disabled", "value": "false" }
                    ],
                    "default": "",
                    "xs": 12,
                    "sm": 6,
                    "md": 4
                },
                "tsStrictNullChecks": {
                    "type": "select",
                    "label": "strictNullChecks",
                    "options": [
                        { "label": "Follow strict", "value": "" },
                        { "label": "Enabled", "value": "true" },
                        { "label": "Disabled", "value": "false" }
                    ],
                    "default": "",
                    "xs": 12,
                    "sm": 6,
                    "md": 4
                },
                "tsStrictFunctionTypes": {
                    "type": "select",
                    "label": "strictFunctionTypes",
                    "options": [
                        { "label": "Follow strict", "value": "" },
