                "tsStrictPropertyInitialization": {
                    "type": "select",
                    "label": "strictPropertyInitialization",
                    "options": [
                        { "label": "Follow strict", "value": "" },
                        { "label": "Enabled", "value": "true" },
                        { "label": "Disabled", "value": "false" }
                    ],
                    "default": "",
                    "xs": 12,
                    "sm": 6,
                    "md": 4
                },
                "tsStrictBuiltinIteratorReturn": {
                    "type": "select",
                    "label": "strictBuiltinIteratorReturn",
                    "options": [
                        { "label": "Follow strict", "value": "" },
                        { "label": "Enabled", "value": "true" },
                        { "label": "Disabled", "value": "false" }
                    ],
                    "default": "",
                    "xs": 12,
                    "sm": 6,
                    "md": 4
                },
                "tsNoImplicitThis": {
                    "newLine": true,
                    "type": "select",
                    "label": "noImplicitThis",
                    "options": [
                        { "label": "Follow strict", "value": "" },
                        { "label": "Enabled", "value": "true" },
                        { "label": "Disabled", "value": "false" }
                    ],
                    "default": "",
                    "xs": 12,
                    "sm": 6,
                    "md": 4
                },
                "tsAlwaysStrict": {
                    "type": "select",
                    "label": "alwaysStrict",
                    "options": [
                        { "label": "Follow strict", "value": "" },
                        { "label": "Enabled", "value": "true" },
                        { "label": "Disabled", "value": "false" }
                    ],
                    "default": "",
                    "xs": 12,
                    "sm": 6,
                    "md": 4
                },
                "tsUseUnknownInCatchVariables": {
                    "type": "select",
                    "label": "useUnknownInCatchVariables",
