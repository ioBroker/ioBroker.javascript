                    "options": [
                        { "label": "Follow strict", "value": "" },
                        { "label": "Enabled", "value": "true" },
                        { "label": "Disabled", "value": "false" }
                    ],
                    "default": "false",
                    "xs": 12,
                    "sm": 6,
                    "md": 4
                },
                "_tsHeaderChecks": {
                    "newLine": true,
                    "type": "header",
                    "text": "Additional checks",
                    "size": 5,
                    "xs": 12,
                    "sm": 12
                },
                "tsNoUnusedLocals": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "noUnusedLocals",
                    "xs": 12,
                    "sm": 6,
                    "md": 4
                },
                "tsNoUnusedParameters": {
                    "type": "checkbox",
                    "label": "noUnusedParameters",
                    "xs": 12,
                    "sm": 6,
                    "md": 4
                },
                "tsNoImplicitReturns": {
                    "type": "checkbox",
                    "label": "noImplicitReturns",
                    "xs": 12,
                    "sm": 6,
                    "md": 4
                },
                "tsNoFallthroughCasesInSwitch": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "noFallthroughCasesInSwitch",
                    "xs": 12,
                    "sm": 6,
                    "md": 4
                },
                "tsNoImplicitOverride": {
                    "type": "checkbox",
                    "label": "noImplicitOverride",
                    "xs": 12,
                    "sm": 6,
                    "md": 4
                },
                "tsNoUncheckedIndexedAccess": {
                    "type": "checkbox",
                    "label": "noUncheckedIndexedAccess",
                    "xs": 12,
                    "sm": 6,
                    "md": 4
                },
                "tsNoPropertyAccessFromIndexSignature": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "noPropertyAccessFromIndexSignature",
                    "xs": 12,
                    "sm": 6,
                    "md": 4
                },
                "tsExactOptionalPropertyTypes": {
                    "type": "checkbox",
                    "label": "exactOptionalPropertyTypes",
                    "xs": 12,
                    "sm": 6,
                    "md": 4
                },
                "tsAllowUnreachableCode": {
                    "newLine": true,
                    "type": "select",
                    "label": "allowUnreachableCode",
                    "options": [
                        { "label": "Warning", "value": "" },
                        { "label": "Allowed", "value": "true" },
                        { "label": "Error", "value": "false" }
