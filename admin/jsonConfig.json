{
    "type": "tabs",
    "i18n": true,
    "iconPosition": "top",
    "items": {
        "_main": {
            "type": "panel",
            "label": "Main settings",
            "icon": "data:image/svg+xml;base64,",
            "items": {
                "libraries": {
                    "type": "chips",
                    "label": "Additional npm modules",
                    "delimiter": " ",
                    "xs": 12,
                    "sm": 12
                },
                "libraryTypings": {
                    "newLine": true,
                    "type": "chips",
                    "label": "Activate syntax help for these npm modules",
                    "delimiter": " ",
                    "xs": 12,
                    "sm": 12
                },
                "mirrorPath": {
                    "newLine": true,
                    "type": "text",
                    "label": "Mirror scripts to file path",
                    "xs": 12,
                    "sm": 8
                },
                "mirrorInstance": {
                    "hidden": "!data.mirrorPath",
                    "type": "instance",
                    "adapter": "javascript",
                    "label": "Instance, that do mirroring",
                    "xs": 12,
                    "sm": 4
                },
                "enableSetObject": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Enable command \"setObject\"",
                    "xs": 12,
                    "sm": 12,
                    "md": 6
                },
                "enableSendToHost": {
                    "type": "checkbox",
                    "label": "Enable command \"sendToHost\"",
                    "xs": 12,
                    "sm": 12,
                    "md": 6
                },
                "enableExec": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Enable command \"exec\"",
                    "xs": 12,
                    "sm": 12,
                    "md": 6
                },
                "subscribe": {
                    "type": "checkbox",
                    "label": "Do not subscribe all states on start",
                    "xs": 12,
                    "sm": 12,
                    "md": 6
                },
                "maxSetStatePerMinute": {
                    "newLine": true,
                    "type": "number",
                    "label": "Maximum setState requests per Minute per Script",
                    "help": "default 1000",
                    "min": 20,
                    "max": 100000,
                    "xs": 12,
                    "sm": 12,
                    "md": 6
                },
                "maxTriggersPerScript": {
                    "type": "number",
                    "label": "Maximum triggers per Script (until warning)",
                    "help": "default 100",
                    "min": 20,
                    "max": 100000,
                    "xs": 12,
                    "sm": 12,
                    "md": 6
                },
                "allowSelfSignedCerts": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Allow self-signed certificates for URL requests",
                    "xs": 12,
                    "sm": 12
                },
                "sortGlobalScriptsAlphabetically": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Sort global scripts alphabetically",
                    "xs": 12,
                    "sm": 12
                }
            }
        },
        "_astro": {
            "type": "panel",
            "label": "Astro settings",
            "icon": "data:image/svg+xml;base64,",
            "items": {
                "_astroConfig": {
                    "type": "custom",
                    "i18n": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "url": "custom/customComponents.js",
                    "name": "ConfigCustomJavascriptSet/Components/Astro",
                    "guiApi": 2
                },
                "createAstroStates": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Create states for all astro times",
                    "xs": 12,
                    "sm": 12
                }
            }
        },
        "_typescript": {
            "type": "panel",
            "label": "TypeScript",
            "icon": "data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iY3VycmVudENvbG9yIiBkPSJNOS40IDE2LjYgNC44IDEybDQuNi00LjZMOCA2bC02IDYgNiA2IDEuNC0xLjR6bTUuMiAwIDQuNi00LjYtNC42LTQuNkwxNiA2bDYgNi02IDYtMS40LTEuNHoiLz48L3N2Zz4=",
            "items": {
                "_tsDescription": {
                    "type": "staticText",
                    "text": "TypeScript settings description",
                    "help": "www.typescriptlang.org/tsconfig",
                    "helpLink": "https://www.typescriptlang.org/tsconfig/",
                    "xs": 12,
                    "sm": 12,
                    "style": {
                        "marginBottom": 16
                    }
                },
                "_tsHeaderLanguage": {
                    "newLine": true,
                    "type": "header",
                    "text": "Language and emit",
                    "size": 5,
                    "xs": 12,
                    "sm": 12
                },
                "tsTarget": {
                    "newLine": true,
                    "type": "select",
                    "label": "target",
                    "help": "target help",
                    "options": [
                        { "label": "ES2018", "value": "es2018" },
                        { "label": "ES2019", "value": "es2019" },
                        { "label": "ES2020", "value": "es2020" },
                        { "label": "ES2021", "value": "es2021" },
                        { "label": "ES2022", "value": "es2022" },
                        { "label": "ES2023", "value": "es2023" },
                        { "label": "ES2024", "value": "es2024" },
                        { "label": "ES2025", "value": "es2025" },
                        { "label": "ESNext", "value": "esnext" }
                    ],
                    "default": "es2022",
                    "xs": 12,
                    "sm": 6,
                    "md": 4
                },
                "tsNoEmitOnError": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "noEmitOnError",
                    "help": "noEmitOnError help",
                    "default": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4
                },
                "tsEsModuleInterop": {
                    "type": "checkbox",
                    "label": "esModuleInterop",
                    "help": "esModuleInterop help",
                    "default": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4
                },
                "tsAllowSyntheticDefaultImports": {
                    "type": "checkbox",
                    "label": "allowSyntheticDefaultImports",
                    "xs": 12,
                    "sm": 6,
                    "md": 4
                },
                "tsUseDefineForClassFields": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "useDefineForClassFields",
                    "help": "useDefineForClassFields help",
                    "xs": 12,
                    "sm": 6,
                    "md": 4
                },
                "tsDownlevelIteration": {
                    "type": "checkbox",
                    "label": "downlevelIteration",
                    "xs": 12,
                    "sm": 6,
                    "md": 4
                },
                "tsExperimentalDecorators": {
                    "type": "checkbox",
                    "label": "experimentalDecorators",
                    "xs": 12,
                    "sm": 6,
                    "md": 4
                },
                "tsEmitDecoratorMetadata": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "emitDecoratorMetadata",
                    "disabled": "!data.tsExperimentalDecorators",
                    "xs": 12,
                    "sm": 6,
                    "md": 4
                },
                "tsRemoveComments": {
                    "type": "checkbox",
                    "label": "removeComments",
                    "xs": 12,
                    "sm": 6,
                    "md": 4
                },
                "tsSkipLibCheck": {
                    "type": "checkbox",
                    "label": "skipLibCheck",
                    "help": "skipLibCheck help",
                    "xs": 12,
                    "sm": 6,
                    "md": 4
                },
                "_tsHeaderStrict": {
                    "newLine": true,
                    "type": "header",
                    "text": "Strict type checking",
                    "size": 5,
                    "xs": 12,
                    "sm": 12
                },
                "tsStrict": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "strict",
                    "help": "strict help",
                    "xs": 12,
                    "sm": 12
