// Specialized tsconfig for the admin directory,
// includes DOM typings and configures the admin build
{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "checkJs": false,
        "noEmit": true,
        // fb-core (see "paths") is shared with the backend and lives outside this package
        "rootDir": "..",
        "strictNullChecks": true,
        "strict": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "sourceMap": true,
        "sourceRoot": "./src",
        "noImplicitAny": true,
        "skipLibCheck": true,
        "lib": ["es2018", "DOM"],
        "jsx": "react",
        "types": ["vite/client", "@iobroker/types"],
        "paths": {
            "@/*": ["./src/*"],
            // fb-core (model, block library, code generator of the function block diagrams) lives
            // in the backend, because the adapter uses it as well
            "@fb-core": ["../src/lib/fb/index.ts"],
            // "blockly" does not expose its internal modules via "exports", so "bundler"
            // resolution cannot find them. These are type-only imports and are erased on emit.
            "blockly/core/*": ["./node_modules/blockly/core/*"]
        }
    },
    "include": ["./src/**/*", "./src/types.d.ts"],
    "exclude": ["./src/Components/BlocklyEditorTS.tsx"]
}
