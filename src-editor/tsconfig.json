// Specialized tsconfig for the admin directory,
// includes DOM typings and configures the admin build
{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        // No "baseUrl" (deprecated in TS 6): "paths" below resolve relative to this file.
        "allowSyntheticDefaultImports": true,
        "checkJs": false,
        // Vite emits the bundle, "tsc" is only a type-check gate. Emitting here would also
        // write ../src/lib/consts.js, because src/types.d.ts pulls in a file outside "rootDir".
        "noEmit": true,
        "strictNullChecks": true,
        "strict": true,
        "rootDir": "./src",
        // Vite bundles this app, so override the CommonJS/node16 settings from the base config
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "sourceMap": true,
        "sourceRoot": "./src",
        "noImplicitAny": true,
        "skipLibCheck": true,
        "lib": ["es2018", "DOM"],
        "jsx": "react",
        "types": ["vite/client", "@iobroker/types"],
        "paths": {
            "@/*": ["./src/*"],
            // "blockly" does not expose its internal modules via "exports", so "bundler"
            // resolution cannot find them. These are type-only imports and are erased on emit.
            "blockly/core/*": ["./node_modules/blockly/core/*"]
        }
    },
    "include": ["./src/**/*", "./src/types.d.ts"],
    "exclude": ["./src/Components/BlocklyEditorTS.tsx"]
}
