{
    "compileOnSave": true,
    "extends": "@tsconfig/node22/tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "allowJs": false,
        "checkJs": true,
        "outDir": "./build/",
        "sourceMap": true,
        "inlineSources": true,
        "module": "node16",
        "moduleResolution": "node16",
        "resolveJsonModule": true,
        "strict": true,
        "noImplicitAny": true,
        "target": "es2022",
        "esModuleInterop": true,
        "types": ["@types/node", "@iobroker/types"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules/**", "admin/**"]
}
